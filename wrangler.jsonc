{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "calcusite",
  "main": "src/index.js",
  "compatibility_date": "2026-10-08",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/blog", "/blog/*"]
  }
}
